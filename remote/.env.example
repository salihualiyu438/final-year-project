# Phase 6 remote deployment environment variables
# PowerShell example:
#
# $env:SURVEILLANCE_SECURE_COOKIE="1"
# $env:SURVEILLANCE_SESSION_SECRET="generate-a-long-random-secret"
# $env:SURVEILLANCE_OWNER_PASSWORD="change-this"
# $env:SURVEILLANCE_OPERATOR_PASSWORD="change-this"
#
# Keep these values private. Do not put real secrets in source code.
SURVEILLANCE_SECURE_COOKIE=1
SURVEILLANCE_SESSION_SECRET=
SURVEILLANCE_OWNER_PASSWORD=
SURVEILLANCE_OPERATOR_PASSWORD=
SURVEILLANCE_BIND_HOST=127.0.0.1
SURVEILLANCE_PORT=8000
